<%= form_with(model: [commentable, comment]) do |form| %>
  <% if comment.errors.any? %>
    <div style="color: red">
      <h2><%= t('views.common.validation_error', errors: i18n_error_count(comment.errors.count), name: Comment.model_name.human.downcase) %>:</h2>

      <ul>
        <% comment.errors.full_messages.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.text_area :comment, required: true %>
  </div>

  <div>
    <%= form.submit %>
    <% if params[:inline] %>
      <%= link_to t('views.common.back', name: i18n_pluralize(Comment.model_name.human.downcase)), polymorphic_path([comment.commentable]), data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %>
